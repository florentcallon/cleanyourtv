<?xml version="1.0" encoding="utf-8"?>
<!-- Window changes of the Live TV app only (packageNames), and the package of the window in front when the
     service binds (canRetrieveWindowContent). No key filtering. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="true"
    android:packageNames="org.droidtv.playtv"
    android:notificationTimeout="0"
    android:description="@string/boot_home_description" />
